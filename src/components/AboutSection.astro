---
---

<!-- ABOUT CLINIC SECTION -->
<section class="w-full py-20 lg:py-28 bg-surface-container-low" id="o-klinice">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Image with subtle border and floating badge -->
      <div class="lg:col-span-5 relative order-2 lg:order-1 reveal">
        <div class="rounded-3xl overflow-hidden shadow-xl bg-surface-container relative group">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvPPZmY0bpgyD46p6Lnz3mFEFhsi6lUt4LX5mjgWQfqn6S3pP0aga_64CoHsdU6-1JRYqvimZkzjrC_xiiUB3ma_NGZdCCLUsLB8qaLJjRMgrNSlgWDLUVnPmmtX-CDDY_XezWYIVDu-_vbga9XCuTy7mddSzzlHR32hFiJP2C8z8d1OITlagFuVrmzNL5Niq0KFQ0XYzAXnbKdw6MAQhmbH8VFHeYlzclQW_Zow7u_dE4uEH8gvfjAw"
            alt="Wnętrze gabinetu stomatologicznego AuraDent"
            class="w-full h-[480px] object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"></div>
          
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-surface-container-lowest/95 backdrop-blur-md shadow-lg border border-white/20">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">verified</span>
              <div>
                <div class="font-semibold text-xs text-on-surface">Certyfikowany Ośrodek MedTech Excellence</div>
                <div class="text-[11px] text-on-surface-variant">Standardy leczenia ITI i PTE • Akredytacja ISO 9001</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative without AI kickers -->
      <div class="lg:col-span-7 space-y-6 order-1 lg:order-2 reveal">
        <h2 class="font-headline-xl text-headline-xl text-on-surface font-normal leading-tight text-3xl lg:text-4xl">
          Medyczna doskonałość w <span class="font-semibold text-secondary">kameralnym wydaniu</span>
        </h2>

        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          AuraDent powstała z przekonania, że wizyta u stomatologa nie musi kojarzyć się ze stresem, zapachem szpitalnego korytarza i obezwładniającym lękiem. Stworzyliśmy przestrzeń, która łączy precyzję szwajcarskich laboratoriów z atmosferą wyciszającego spa.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-1.5">
            <div class="flex items-center gap-2 text-secondary font-semibold text-xs">
              <span class="material-symbols-outlined text-lg" aria-hidden="true">biotech</span>
              <span>Cyfrowy Workflow 100%</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Projektowanie uśmiechu CAD/CAM w 3D, wirtualne przymiarki i precyzyjne szablony chirurgiczne.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-1.5">
            <div class="flex items-center gap-2 text-secondary font-semibold text-xs">
              <span class="material-symbols-outlined text-lg" aria-hidden="true">sanitizer</span>
              <span>Sterylizacja Klasy B</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Autoklawy Melag najnowszej generacji z elektronicznym paszportem sterylizacji każdego pakietu.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-1.5">
            <div class="flex items-center gap-2 text-secondary font-semibold text-xs">
              <span class="material-symbols-outlined text-lg" aria-hidden="true">psychology</span>
              <span>Protokół Przeciwlękowy</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Program dla pacjentów z dentofobią: sedacja, znieczulenie The Wand i wyciszająca relaksacja.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-1.5">
            <div class="flex items-center gap-2 text-secondary font-semibold text-xs">
              <span class="material-symbols-outlined text-lg" aria-hidden="true">emergency</span>
              <span>Dyżur Bólowy 24/7</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Gwarancja natychmiastowego przyjęcia w ostrych stanach zapalnych i urazach każdego dnia.
            </p>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="#zabiegi-i-technologie"
            class="inline-flex items-center gap-2 text-xs text-secondary font-semibold hover:underline min-h-[44px]"
          >
            <span>Poznaj nasze technologie zabiegowe</span>
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_downward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TREATMENTS & TECHNOLOGIES SECTION -->
<section class="w-full py-20 lg:py-28 bg-surface" id="zabiegi-i-technologie">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header without AI kicker -->
    <div class="max-w-3xl mb-14 space-y-3 reveal">
      <h2 class="font-headline-xl text-headline-xl text-on-surface font-normal leading-tight text-3xl lg:text-4xl">
        Technologie, które zmieniają <span class="text-secondary font-semibold">komfort leczenia</span>
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        W AuraDent nie stosujemy kompromisów. Każdy gabinet wyposażony jest w sprzęt liderów innowacji medycznej: Carl Zeiss, Straumann, Dentsply Sirona i EMS Medical.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      <!-- Item 1 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">dentistry</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Implantologia Nawigowana 3D
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Wszczepienie implantu z dokładnością do 0.1 mm przy użyciu drukowanego szablonu chirurgicznego. Brak nacięć i szybka regeneracja.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>System Straumann SLActive</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">biotech</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Mikroskopy Carl Zeiss OPMI
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Powiększenie 25x z oświetleniem ksenonowym pozwala odnaleźć i wyleczyć nawet najbardziej zakrzywione kanały, ratując ząb przed usunięciem.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>Skuteczność endodoncji &gt;97%</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">view_in_ar</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Skaner iTero Element 5D Plus
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Cyfrowy wycisk w 60 sekund. Kamera bliskiej podczerwieni NIRI wykrywa ukrytą próchnicę. Koniec z nieprzyjemną masą wyciskową.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>Cyfrowy model 3D w 60s</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">auto_fix_high</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Digital Smile Design (DSD)
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Projektujemy Twój nowy uśmiech w oparciu o proporcje twarzy. Przymierzasz tymczasowy mock-up w lustrze przed rozpoczęciem leczenia.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>Wizualizacja przed szlifowaniem</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">cleaning_services</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Guided Biofilm Therapy (GBT)
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Szwajcarski protokół EMS AirFlow z podgrzewaną wodą i pudrem erytrytolowym. Delikatne i bezbolesne usuwanie kamienia i osadu.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>Bezpieczne dla szkliwa i licówek</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>

      <!-- Item 6 -->
      <div class="p-7 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-surface-container/60 card-lift flex flex-col justify-between reveal">
        <div class="space-y-3.5">
          <div class="w-12 h-12 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">radiology</span>
          </div>
          <h3 class="font-semibold text-base text-on-surface">
            Tomografia CBCT &amp; RTG HD
          </h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Własna pracownia rentgenowska z aparatem cyfrowym o zredukowanej dawce promieniowania. Trójwymiarowa rekonstrukcja kości na miejscu.
          </p>
        </div>
        <div class="pt-5 mt-5 border-t border-surface-container-low flex items-center justify-between text-xs text-secondary font-medium">
          <span>Wynik w 3 minuty w klinice</span>
          <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
        </div>
      </div>
    </div>
  </div>
</section>

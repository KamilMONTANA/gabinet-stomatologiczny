---
---

<section class="w-full py-20 lg:py-28 bg-surface" id="kontakt">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header without AI kicker -->
    <div class="max-w-3xl mb-14 space-y-3 reveal">
      <h2 class="font-headline-xl text-headline-xl text-on-surface font-normal leading-tight text-3xl lg:text-4xl">
        Odwiedź nas w <span class="text-secondary font-semibold">sercu Warszawy</span>
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Klinika mieści się w zabytkowej kamienicy przy ul. Mokotowskiej 42. Oferujemy prywatny parking dla pacjentów oraz dogodny dojazd komunikacją miejską.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column: Contact Cards & Practical Info -->
      <div class="lg:col-span-6 space-y-5 reveal">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Card 1: Telefon -->
          <div class="p-6 rounded-3xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-2.5 card-lift">
            <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl" aria-hidden="true">call</span>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider">Recepcja kliniki</div>
              <a
                href="tel:+48228901234"
                aria-label="Zadzwoń do recepcji kliniki pod numer +48 22 890 12 34"
                class="text-base font-bold text-on-surface hover:text-secondary transition-colors block mt-0.5 focus:outline-none min-h-[44px] flex items-center"
              >
                +48 22 890 12 34
              </a>
              <div class="text-[11px] text-on-surface-variant mt-0.5">Pn - Pt: 08:00 - 20:00</div>
            </div>
          </div>

          <!-- Card 2: Dyżur 24/7 -->
          <div class="p-6 rounded-3xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-2.5 card-lift">
            <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
              <span class="material-symbols-outlined text-xl" aria-hidden="true">emergency</span>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-red-600 tracking-wider">Dyżur pilny 24/7</div>
              <a
                href="tel:+48228901235"
                aria-label="Zadzwoń na ostry dyżur bólowy 24/7 pod numer +48 22 890 12 35"
                class="text-base font-bold text-on-surface hover:text-red-600 transition-colors block mt-0.5 focus:outline-none min-h-[44px] flex items-center"
              >
                +48 22 890 12 35
              </a>
              <div class="text-[11px] text-on-surface-variant mt-0.5">Ostre stany bólowe noc &amp; weekend</div>
            </div>
          </div>

          <!-- Card 3: Adres -->
          <div class="p-6 rounded-3xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-2.5 card-lift">
            <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl" aria-hidden="true">location_city</span>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider">Adres gabinetu</div>
              <div class="text-sm font-semibold text-on-surface mt-0.5">
                ul. Mokotowska 42
              </div>
              <div class="text-[11px] text-on-surface-variant mt-0.5">00-543 Warszawa (Śródmieście)</div>
            </div>
          </div>

          <!-- Card 4: E-mail -->
          <div class="p-6 rounded-3xl bg-surface-container-lowest border border-surface-container/60 shadow-sm space-y-2.5 card-lift">
            <div class="w-10 h-10 rounded-xl bg-surface-container-low text-secondary flex items-center justify-center">
              <span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-on-surface-variant tracking-wider">Korespondencja</div>
              <a
                href="mailto:recepcja@auradent.pl"
                aria-label="Napisz e-mail do recepcji na adres recepcja@auradent.pl"
                class="text-sm font-semibold text-on-surface hover:text-secondary transition-colors block mt-0.5 focus:outline-none min-h-[44px] flex items-center"
              >
                recepcja@auradent.pl
              </a>
              <div class="text-[11px] text-on-surface-variant mt-0.5">Odpowiedź do 2h roboczych</div>
            </div>
          </div>
        </div>

        <!-- Parking & Metro Info -->
        <div class="p-6 rounded-3xl bg-surface-container-low border border-surface-container/60 space-y-2">
          <div class="font-semibold text-on-surface text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">directions_car</span>
            <span>Parking &amp; Dojazd komunikacją miejską</span>
          </div>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Dla pacjentów AuraDent udostępniamy 4 dedykowane miejsca w parkingu podziemnym (wjazd od ul. Wilczej, domofon "AuraDent"). Metro Politechnika znajduje się 4 minuty spacerem od kliniki.
          </p>
        </div>
      </div>

      <!-- Right Column: Direct Quick Contact Form -->
      <div class="lg:col-span-6 reveal">
        <div class="p-8 md:p-10 rounded-3xl bg-surface-container-lowest shadow-sm border border-surface-container/60">
          <h3 class="font-headline-sm text-lg font-semibold text-on-surface mb-1.5">
            Napisz do nas bezpośrednio
          </h3>
          <p class="text-xs text-on-surface-variant mb-6">
            Masz pytania o plan leczenia, wycenę lub potrzebujesz konsultacji? Skontaktujemy się telefonicznie lub mailowo.
          </p>

          <form id="contact-quick-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-on-surface mb-1.5">
                Imię i nazwisko <span class="text-secondary" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                aria-required="true"
                autocomplete="name"
                placeholder="Jan Nowak"
                class="w-full px-4 py-2.5 rounded-xl border border-surface-container bg-surface focus:outline-none focus:ring-2 focus:ring-secondary/40 focus:border-secondary transition-all text-xs min-h-[44px]"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-phone" class="block text-xs font-semibold text-on-surface mb-1.5">
                  Telefon <span class="text-secondary" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-phone"
                  name="tel"
                  type="tel"
                  required
                  aria-required="true"
                  autocomplete="tel"
                  placeholder="+48 ___ ___ ___"
                  class="w-full px-4 py-2.5 rounded-xl border border-surface-container bg-surface focus:outline-none focus:ring-2 focus:ring-secondary/40 focus:border-secondary transition-all text-xs min-h-[44px]"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-xs font-semibold text-on-surface mb-1.5">
                  Adres e-mail <span class="text-secondary" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  aria-required="true"
                  autocomplete="email"
                  placeholder="jan@example.com"
                  class="w-full px-4 py-2.5 rounded-xl border border-surface-container bg-surface focus:outline-none focus:ring-2 focus:ring-secondary/40 focus:border-secondary transition-all text-xs min-h-[44px]"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-on-surface mb-1.5">
                Wiadomość lub pytanie <span class="text-secondary" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="3"
                required
                aria-required="true"
                placeholder="W czym możemy Ci pomóc? Np. wycena licówek, konsultacja implantologiczna..."
                class="w-full px-4 py-2.5 rounded-xl border border-surface-container bg-surface focus:outline-none focus:ring-2 focus:ring-secondary/40 focus:border-secondary transition-all text-xs min-h-[80px]"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-full bg-secondary hover:bg-on-secondary-container text-on-secondary font-semibold text-xs transition-all shadow-md flex items-center justify-center gap-2 btn-tactile min-h-[44px]"
            >
              <span class="material-symbols-outlined text-base" aria-hidden="true">send</span>
              <span>Wyślij zapytanie do recepcji</span>
            </button>
          </form>

          <div
            id="contact-success-msg"
            role="status"
            aria-live="polite"
            class="hidden mt-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-center text-xs font-semibold"
          >
            Dziękujemy! Twoja wiadomość została wysłana. Skontaktujemy się najszybciej jak to możliwe.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-quick-form');
  const contactMsg = document.getElementById('contact-success-msg');

  if (contactForm && contactMsg) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      (contactForm as HTMLFormElement).reset();
      contactMsg.classList.remove('hidden');
      setTimeout(() => {
        contactMsg.classList.add('hidden');
      }, 5000);
    });
  }
</script>

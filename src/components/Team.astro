---

<section class="w-full py-20 lg:py-28 bg-surface-container-low" id="nasz-zespol">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header without AI kicker -->
    <div class="max-w-3xl mb-14 space-y-3 reveal">
      <h2 class="font-headline-xl text-headline-xl text-on-surface font-normal leading-tight text-3xl lg:text-4xl">
        Poznaj zespół specjalistów AuraDent
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Nasi lekarze łączą stopnie naukowe z wieloletnim doświadczeniem klinicznym w Szwajcarii, Niemczech i USA.
      </p>
    </div>

    <!-- Doctors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7">
      <!-- Doctor 1 -->
      <div class="p-6 rounded-3xl bg-surface-container-lowest shadow-sm flex flex-col justify-between hover:shadow-md transition-all border border-surface-container/60 card-lift reveal">
        <div>
          <div class="rounded-2xl overflow-hidden mb-5 relative aspect-[4/5] bg-surface-container shadow-sm group">
            <img
              class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
              alt="dr n. med. Aleksander Czarnecki"
              data-alt="Distinguished mature male dental surgeon in elegant navy medical scrub smiling warmly"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDL1NWArs-fxFXMrL_lrzohabH5dYOGnOJFBsWwX_DNNgBhTgIJsYjQusjh-2ClfVTHkRkv0YnVryS37PifUu1Ga5EZQFw0SDUa49TOz3o9zq5CrUxzlBkfGVhGUv2sAj4IWpCCPgIbJ9hDcSdSIz-A8LAwnLja9dzw57l5aTas2ziCpgzJGxIkBwkypZnXGw4JXM4admXSeDk_9QaQ60tqSj85Rue4Shk66w2I6XiAegsSjKv59YCLfg"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-primary-container/95 backdrop-blur-sm text-on-primary text-[11px] font-semibold shadow-sm">
              Kierownik Medyczny
            </span>
          </div>
          <div class="space-y-1.5">
            <span class="text-[10px] uppercase tracking-widest text-secondary font-bold">
              Implantologia & Chirurgia
            </span>
            <h3 class="font-headline-sm text-base font-semibold text-on-surface leading-snug">
              dr n. med. Aleksander Czarnecki
            </h3>
            <p class="text-xs text-on-surface-variant line-clamp-3 leading-relaxed mt-1">
              18 lat doświadczenia klinicznego. Ponad 4000 pomyślnie wszczepionych implantów. Członek International Team for Implantology (ITI).
            </p>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-surface-container-low space-y-3">
          <div class="flex items-center justify-between text-on-surface-variant text-xs">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">calendar_month</span>
              <span>Przyjmuje:</span>
            </span>
            <span class="font-semibold text-on-surface">Pon, Śr, Pt</span>
          </div>
          <a
            href="#rezerwacja"
            aria-label="Sprawdź wolne terminy u dr n. med. Aleksandra Czarneckiego"
            class="w-full py-2.5 rounded-full bg-surface-container-low hover:bg-secondary hover:text-on-secondary text-secondary text-xs font-semibold transition-all text-center block btn-tactile min-h-[44px] flex items-center justify-center"
          >
            Sprawdź wolne terminy
          </a>
        </div>
      </div>

      <!-- Doctor 2 -->
      <div class="p-6 rounded-3xl bg-surface-container-lowest shadow-sm flex flex-col justify-between hover:shadow-md transition-all border border-surface-container/60 card-lift reveal">
        <div>
          <div class="rounded-2xl overflow-hidden mb-5 relative aspect-[4/5] bg-surface-container shadow-sm group">
            <img
              class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
              alt="lek. dent. Natalia Wiśniewska — Stomatologia Estetyczna"
              data-alt="Professional stylish female aesthetic dentist in chic medical attire, friendly radiant natural smile"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAgIfMRB6at1f6l-S4NUKFuD21VEXymAQVB5Cllc2HZ7dtnTTY7D32QIuowhy8Xrb6ZDrF-Ds0WqQrRNnOpb4_lA6zWqn6Px3FUl69CpLyczQqyjKDu98t_iYPjrB7RSkV6tqFK7Y8CMFRkfSr8uFgdxEDo5IWXZnGFGnGdrRSp2VpECczbWtvfgq2O13yMQxISKZb_6BLjwV7cH5Nq3tN5n-hY6SPAUhR0PmtDnwW2VedFRjvnRTOY6A"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-secondary/95 backdrop-blur-sm text-on-secondary text-[11px] font-semibold shadow-sm">
              DSD Key Opinion Leader
            </span>
          </div>
          <div class="space-y-1.5">
            <span class="text-[10px] uppercase tracking-widest text-secondary font-bold">
              Stomatologia Estetyczna
            </span>
            <h3 class="font-headline-sm text-base font-semibold text-on-surface leading-snug">
              lek. dent. Natalia Wiśniewska
            </h3>
            <p class="text-xs text-on-surface-variant line-clamp-3 leading-relaxed mt-1">
              Mistrzyni licówek minimalnie inwazyjnych bez szlifowania. Specjalizuje się w kompleksowych metamorfozach Digital Smile Design.
            </p>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-surface-container-low space-y-3">
          <div class="flex items-center justify-between text-on-surface-variant text-xs">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">calendar_month</span>
              <span>Przyjmuje:</span>
            </span>
            <span class="font-semibold text-on-surface">Wt, Czw, Sob</span>
          </div>
          <a
            href="#rezerwacja"
            aria-label="Sprawdź wolne terminy u lek. dent. Natalii Wiśniewskiej"
            class="w-full py-2.5 rounded-full bg-surface-container-low hover:bg-secondary hover:text-on-secondary text-secondary text-xs font-semibold transition-all text-center block btn-tactile min-h-[44px] flex items-center justify-center"
          >
            Sprawdź wolne terminy
          </a>
        </div>
      </div>

      <!-- Doctor 3 -->
      <div class="p-6 rounded-3xl bg-surface-container-lowest shadow-sm flex flex-col justify-between hover:shadow-md transition-all border border-surface-container/60 card-lift reveal">
        <div>
          <div class="rounded-2xl overflow-hidden mb-5 relative aspect-[4/5] bg-surface-container shadow-sm group">
            <img
              class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
              alt="lek. dent. Piotr Morawski — Endodoncja Mikroskopowa"
              data-alt="Professional male endodontist doctor wearing modern loupe glasses around neck"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDzNFGg6y0FfWS8ops3xQDqVYiwYF6yV3l6xlTxqjdYl_nPV-jfpkUTZxzh1-cepVdoGU8QKE1Kui3c8Tcp7D_fvH308dwW5NLj8Cj_MsWMV2FZLvaCehRsYUzY-yLNpGG3lq1O6heuYt6Y_R9NSugkP9WtrorlKzjtQc7YGy75csAIQvkDWjIzO8z8XZoBDrW9CemFqLDGjX5OqT-dFikgOHhEqJlrUIlmO6pzSriVxuZ8eC2IkAG57w"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-surface-container-highest/95 backdrop-blur-sm text-secondary text-[11px] font-semibold shadow-sm">
              Zeiss 25x Micro
            </span>
          </div>
          <div class="space-y-1.5">
            <span class="text-[10px] uppercase tracking-widest text-secondary font-bold">
              Endodoncja Mikroskopowa
            </span>
            <h3 class="font-headline-sm text-base font-semibold text-on-surface leading-snug">
              lek. dent. Piotr Morawski
            </h3>
            <p class="text-xs text-on-surface-variant line-clamp-3 leading-relaxed mt-1">
              Ratowanie zębów skazanych na usunięcie, usuwanie złamanych narzędzi kanałowych, leczenie perforacji i powikłań. Członek PTE.
            </p>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-surface-container-low space-y-3">
          <div class="flex items-center justify-between text-on-surface-variant text-xs">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">calendar_month</span>
              <span>Przyjmuje:</span>
            </span>
            <span class="font-semibold text-on-surface">Pon, Wt, Czw</span>
          </div>
          <a
            href="#rezerwacja"
            aria-label="Sprawdź wolne terminy u lek. dent. Piotra Morawskiego"
            class="w-full py-2.5 rounded-full bg-surface-container-low hover:bg-secondary hover:text-on-secondary text-secondary text-xs font-semibold transition-all text-center block btn-tactile min-h-[44px] flex items-center justify-center"
          >
            Sprawdź wolne terminy
          </a>
        </div>
      </div>

      <!-- Doctor 4 -->
      <div class="p-6 rounded-3xl bg-surface-container-lowest shadow-sm flex flex-col justify-between hover:shadow-md transition-all border border-surface-container/60 card-lift reveal">
        <div>
          <div class="rounded-2xl overflow-hidden mb-5 relative aspect-[4/5] bg-surface-container shadow-sm group">
            <img
              class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
              alt="mgr Anna Kwiatkowska — Profilaktyka i Higiena"
              data-alt="Warm, welcoming professional dental clinic specialist headshot"
              src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-surface-container-highest/95 backdrop-blur-sm text-secondary text-[11px] font-semibold shadow-sm">
              Airflow Master Trainer
            </span>
          </div>
          <div class="space-y-1.5">
            <span class="text-[10px] uppercase tracking-widest text-secondary font-bold">
              Profilaktyka i Higiena
            </span>
            <h3 class="font-headline-sm text-base font-semibold text-on-surface leading-snug">
              mgr Anna Kwiatkowska
            </h3>
            <p class="text-xs text-on-surface-variant line-clamp-3 leading-relaxed mt-1">
              Dyplomowana higienistka i instruktorka procedur Guided Biofilm Therapy (GBT). Indywidualny dobór protokołów domowych.
            </p>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-surface-container-low space-y-3">
          <div class="flex items-center justify-between text-on-surface-variant text-xs">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-secondary" aria-hidden="true">calendar_month</span>
              <span>Przyjmuje:</span>
            </span>
            <span class="font-semibold text-on-surface">Pon - Pt (codziennie)</span>
          </div>
          <a
            href="#rezerwacja"
            aria-label="Sprawdź wolne terminy u mgr Anny Kwiatkowskiej"
            class="w-full py-2.5 rounded-full bg-surface-container-low hover:bg-secondary hover:text-on-secondary text-secondary text-xs font-semibold transition-all text-center block btn-tactile min-h-[44px] flex items-center justify-center"
          >
            Sprawdź wolne terminy
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

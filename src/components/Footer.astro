---
---

<footer class="w-full bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] mt-space-xl border-t border-surface-container/60">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-space-xl">
      <!-- Col 1: Brand & Certification -->
      <div class="lg:col-span-4 space-y-space-md">
        <a href="#" class="flex items-center shrink-0 group focus:outline-none" aria-label="AuraDent Clinique &amp; Implanty — Powrót do góry strony">
          <img
            alt="AuraDent Logo"
            class="h-10 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
            src="/logo.svg"
          />
        </a>
        <p class="font-body-md text-body-md text-on-surface-variant pr-4 leading-relaxed">
          Prywatny instytut stomatologii estetycznej, mikrochirurgii i zaawansowanej implantologii cyfrowej. Tworzymy naturalnie harmonijne uśmiechy w atmosferze medycznego luksusu i absolutnego spokoju.
        </p>
        <div class="flex items-center gap-space-sm pt-space-xs text-xs text-on-surface-variant">
          <span class="material-symbols-outlined text-secondary text-xl" aria-hidden="true">verified</span>
          <span class="font-label-sm text-label-sm font-medium">Certyfikowany Ośrodek MedTech Excellence &amp; ISO 9001:2015</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <nav class="lg:col-span-2 space-y-space-sm" aria-label="Nawigacja w stopce">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Nawigacja</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="#o-klinice" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              O klinice
            </a>
          </li>
          <li>
            <a href="#zabiegi-i-technologie" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              Implanty i All-on-4
            </a>
          </li>
          <li>
            <a href="#zabiegi-i-technologie" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              Stomatologia estetyczna
            </a>
          </li>
          <li>
            <a href="#cennik" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              Przejrzysty Cennik
            </a>
          </li>
          <li>
            <a href="#nasz-zespol" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              Zespół specjalistów
            </a>
          </li>
          <li>
            <a href="#kontakt" class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer block">
              Kontakt i dojazd
            </a>
          </li>
        </ul>
      </nav>

      <!-- Col 3: Safety & Location -->
      <div class="lg:col-span-3 space-y-space-sm">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Bezpieczeństwo &amp; Gwarancja</h3>
        <div class="p-space-md rounded-xl bg-surface-container-low space-y-2 border border-surface-container/40">
          <div class="flex items-center gap-2 text-secondary">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">health_and_safety</span>
            <span class="font-label-md text-label-md font-semibold text-on-surface">Gwarancja komfortu</span>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant text-xs leading-relaxed">
            Bezwzględny standard leczenia bezbólowego dzięki komputerowej sedacji wziewnej i mikroskopowej precyzji leczenia.
          </p>
        </div>
        <div class="space-y-1 pt-1 text-xs">
          <div class="font-label-md text-label-md text-on-surface font-semibold">Centrum przyjęć:</div>
          <div class="font-body-md text-body-md text-on-surface-variant">ul. Mokotowska 42, 00-543 Warszawa</div>
          <a
            href="mailto:recepcja@auradent.pl"
            aria-label="Napisz e-mail do recepcji kliniki: recepcja@auradent.pl"
            class="font-body-md text-body-md text-secondary font-medium block hover:underline"
          >
            recepcja@auradent.pl
          </a>
        </div>
      </div>

      <!-- Col 4: Hours & Emergency -->
      <div class="lg:col-span-3 space-y-space-sm">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Godziny przyjęć</h3>
        <div class="space-y-2 text-xs text-on-surface-variant">
          <div class="flex justify-between py-1 border-b border-surface-container">
            <span>Poniedziałek - Piątek:</span>
            <span class="font-semibold text-on-surface">08:00 - 20:00</span>
          </div>
          <div class="flex justify-between py-1 border-b border-surface-container">
            <span>Sobota (konsultacje):</span>
            <span class="font-semibold text-on-surface">09:00 - 16:00</span>
          </div>
          <div class="flex justify-between py-1 border-b border-surface-container">
            <span>Niedziela &amp; Święta:</span>
            <span class="font-semibold text-red-600">Dyżur bólowy 24/7</span>
          </div>
        </div>
        <div class="pt-3">
          <a
            href="tel:+48228901234"
            aria-label="Zadzwoń do kliniki pod numer +48 22 890 12 34"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm font-semibold hover:bg-on-secondary-container transition-all shadow-sm min-h-[44px]"
          >
            <span class="material-symbols-outlined text-sm" aria-hidden="true">call</span>
            <span>+48 22 890 12 34</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom sub-footer -->
    <div class="pt-12 mt-12 border-t border-surface-container flex flex-col sm:flex-row items-center justify-between gap-4 font-label-md text-label-md text-on-surface-variant text-xs">
      <p>© 2025 AuraDent Clinique &amp; Implanty. Wszelkie prawa zastrzeżone.</p>
      <nav class="flex items-center gap-space-lg flex-wrap" aria-label="Informacje prawne">
        <a href="#" class="hover:text-on-surface cursor-pointer">Polityka prywatności</a>
        <a href="#" class="hover:text-on-surface cursor-pointer">Standardy MedTech</a>
        <a href="#" class="hover:text-on-surface cursor-pointer">Zgody RODO</a>
        <a href="#" class="hover:text-on-surface cursor-pointer">Regulamin leczenia</a>
      </nav>
    </div>
  </div>
</footer>

---
---

<section class="relative w-full overflow-hidden bg-surface py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-7 space-y-8 reveal">
        <h1 class="font-display-lg text-display-lg text-on-surface font-bold leading-[1.12] tracking-tight text-3xl sm:text-4xl md:text-5xl lg:text-[54px]">
          Perfekcyjny uśmiech oparty na <span class="font-bold text-secondary">nauce i empatii</span>
        </h1>

        <p class="font-body-xl text-body-xl text-on-surface-variant max-w-2xl leading-relaxed text-base sm:text-lg">
          Doświadcz bezstresowej stomatologii mikroskopowej, implantologii 3D oraz cyfrowego projektowania uśmiechu w sercu Warszawy. Tworzymy naturalne piękno bez bólu i niepewności.
        </p>

        <!-- Refined Editorial Proof Strip (replaces AI-slop repetitive square boxes) -->
        <div class="pt-2 pb-2">
          <div class="p-6 rounded-2xl bg-surface-container-lowest border border-surface-container/60 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-6">
            <!-- Metric 1 -->
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl" aria-hidden="true" style='font-variation-settings: "FILL" 1;'>star</span>
              </div>
              <div>
                <div class="font-bold text-base text-on-surface leading-tight">4.9 / 5.0</div>
                <div class="text-xs text-on-surface-variant mt-0.5">&gt;1 850 opinii ZnanyLekarz</div>
              </div>
            </div>

            <div class="hidden sm:block w-px h-10 bg-surface-container"></div>

            <!-- Metric 2 -->
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-sky-50 text-secondary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl" aria-hidden="true">favorite</span>
              </div>
              <div>
                <div class="font-bold text-base text-on-surface leading-tight">99.4%</div>
                <div class="text-xs text-on-surface-variant mt-0.5">Procedur bez bólu (The Wand)</div>
              </div>
            </div>

            <div class="hidden sm:block w-px h-10 bg-surface-container"></div>

            <!-- Metric 3 -->
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl" aria-hidden="true">workspace_premium</span>
              </div>
              <div>
                <div class="font-bold text-base text-on-surface leading-tight">10 lat</div>
                <div class="text-xs text-on-surface-variant mt-0.5">Paszport Straumann</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Primary Actions -->
        <div class="pt-1 flex flex-wrap items-center gap-4">
          <a
            href="#rezerwacja"
            class="px-8 py-4 rounded-full bg-secondary hover:bg-on-secondary-container text-on-secondary font-semibold text-sm transition-all shadow-md flex items-center gap-2.5 btn-tactile min-h-[44px]"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">calendar_add_on</span>
            <span>Zarezerwuj wizytę online</span>
          </a>
          <a
            href="#cennik"
            class="px-7 py-4 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface font-semibold text-sm transition-all flex items-center gap-2 btn-tactile min-h-[44px]"
          >
            <span>Zobacz cennik</span>
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Right Visual Showcase -->
      <div class="lg:col-span-5 relative reveal">
        <div class="relative rounded-3xl overflow-hidden bg-surface-container-lowest shadow-xl border border-surface-container/40 group">
          <img
            class="w-full h-[470px] object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
            alt="Wnętrze kliniki stomatologicznej AuraDent w Warszawie"
            data-alt="Modern ultra-luxurious dental clinic interior in Warsaw with serene minimalist architectural decor"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvPPZmY0bpgyD46p6Lnz3mFEFhsi6lUt4LX5mjgWQfqn6S3pP0aga_64CoHsdU6-1JRYqvimZkzjrC_xiiUB3ma_NGZdCCLUsLB8qaLJjRMgrNSlgWDLUVnPmmtX-CDDY_XezWYIVDu-_vbga9XCuTy7mddSzzlHR32hFiJP2C8z8d1OITlagFuVrmzNL5Niq0KFQ0XYzAXnbKdw6MAQhmbH8VFHeYlzclQW_Zow7u_dE4uEH8gvfjAw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/75 via-transparent to-transparent"></div>

          <!-- Refined Live Duty Capsule -->
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-surface-container-lowest/95 backdrop-blur-md shadow-lg border border-white/20 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="relative flex h-3 w-3 shrink-0" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-secondary"></span>
              </span>
              <div>
                <div class="font-semibold text-xs text-on-surface">Dzisiejszy dyżur chirurgiczny</div>
                <div class="text-[11px] text-on-surface-variant">Wolne okna: 15:40, 18:15</div>
              </div>
            </div>
            <a
              class="px-4 py-2 rounded-full bg-secondary text-on-secondary text-xs font-semibold hover:bg-on-secondary-container transition-all shrink-0 btn-tactile min-h-[44px] flex items-center justify-center"
              href="#rezerwacja"
              aria-label="Wybierz termin dzisiejszego dyżuru chirurgicznego"
            >
              Wybierz
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
